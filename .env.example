# Config del proyecto de Firebase "scild-emergencia" (Authentication).
# Estos valores NO son secretos (identifican el proyecto, no dan acceso por
# sí solos), pero igual no se versiona el .env real para evitar mezclar
# ambientes por accidente.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave pública para notificaciones push web. Se genera una sola vez en
# Firebase Console → Configuración del proyecto → Cloud Messaging →
# "Certificados push web" → Generar par de claves, y se copia la columna
# "Clave" (empieza con B..., ~88 caracteres). También es pública.
VITE_FIREBASE_VAPID_KEY=

# URL del backend (scild-backend).
VITE_API_URL=http://localhost:3000
