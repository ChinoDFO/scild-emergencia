<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla completa que despierta el celular para CUALQUIER alerta (SOS,
    botón físico, o un tipo como "Carro sospechoso"). Se muestra con
    setFullScreenIntent, como una app de alarmas o una llamada entrante. Ver
    AlertaMessagingService.

    Mismo lenguaje visual que el inicio de sesión de la web (TarjetaSesion):
    fondo sólido oscuro de pantalla completa, con una tarjeta muy redondeada
    encima en degradado de negro (abajo) a gris oscuro (arriba), logo de la
    marca en la esquina y botones en píldora.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14171C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:orientation="vertical"
        android:background="@drawable/fondo_tarjeta_alarma"
        android:padding="28dp">

        <!-- Fila del logo: un espaciador que lo empuja a la esquina
             superior derecha de la tarjeta, grande a propósito. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/logo_marca"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/alarmaTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Emergencia"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/alarmaCuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp"
            android:textColor="#D9DCE1"
            android:textSize="16sp"
            android:gravity="center" />

        <Button
            android:id="@+id/alarmaVerBoton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Enterado"
            android:textColor="#1B0F0F"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="true"
            android:background="@drawable/boton_alarma_primario"
            android:layout_marginBottom="12dp" />

        <!-- Oculto por completo (visibility="gone") cuando la alerta no
             trae mapUrl: ver AlarmaActivity. -->
        <Button
            android:id="@+id/alarmaVerUbicacionBoton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ver ubicación"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="true"
            android:background="@drawable/boton_alarma_secundario"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/alarmaSilenciarBoton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Silenciar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="true"
            android:background="@drawable/boton_alarma_secundario" />

    </LinearLayout>
</FrameLayout>
