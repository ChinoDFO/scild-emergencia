{
  // El service worker corre en otro entorno que la app (sin DOM, con las
  // APIs de WebWorker), así que se revisa con su propia config.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "WebWorker"],
    "module": "esnext",
    "types": ["vite/client", "vite-plugin-pwa/info"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/sw", "src/vite-env.d.ts"]
}
